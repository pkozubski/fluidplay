    "1080p": {},
    "15 Mbps (same as Sony's app)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Mb/s (jak aplikacja Sony)"
          }
        }
      }
    },
    "540p": {},
    "720p": {},
    "720p lets you turn on ML super resolution. H.265 gives a better picture at the same bandwidth. A higher bitrate means less blockiness in fast scenes, but more lost packets on weak Wi‑Fi — the stats show how many Mbps actually arrive.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "720p pozwala włączyć super rozdzielczość ML. H.265 daje lepszy obraz przy tej samej przepustowości. Wyższa przepływność to mniej „kostki” w szybkich scenach, ale na słabym Wi‑Fi więcej zgubionych pakietów — w statystykach widać, ile Mb/s faktycznie przychodzi."
          }
        }
      }
    },
    "8 digits": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "8 cyfr"
          }
        }
      }
    },
    "Account login passcode": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod logowania do konta"
          }
        }
      }
    },
    "Active: %@× to %lld×%lld.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa: %@× do %lld×%lld."
          }
        }
      }
    },
    "Adaptive triggers": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptacyjne spusty"
          }
        }
      }
    },
    "Add PS5 console": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj konsolę PS5"
          }
        }
      }
    },
