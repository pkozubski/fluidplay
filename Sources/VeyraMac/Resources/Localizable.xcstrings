    "Demo": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo"
          }
        }
      }
    },
    "Demo · 30 fps game": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo · gra 30 kl./s"
          }
        }
      }
    },
    "Detects 30 fps games sent in a 60 fps stream, so frames are generated between the real ones.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznaje gry 30 kl./s nadawane w strumieniu 60 kl./s, żeby generować klatki między prawdziwymi."
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran"
          }
        }
      }
    },
    "Display %lld": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran %lld"
          }
        }
      }
    },
    "DualSense mode": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb DualSense"
          }
        }
      }
    },
    "DualSense mode: the console sends haptics, adaptive trigger effects and the light bar color. Turn it off if you play with an Xbox or DualShock 4 controller — you'll get regular vibration.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb DualSense: konsola wysyła haptykę, efekty adaptacyjnych spustów i kolor paska świetlnego. Wyłącz, jeśli grasz na padzie Xbox lub DualShock 4 — dostaniesz zwykłe wibracje."
          }
        }
      }
    },
    "DualSense trigger resistance and vibration, set by the game.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opór i drgania spustów DualSense ustawiane przez grę."
          }
        }
      }
    },
    "End": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ"
          }
        }
      }
    },
    "End game": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ grę"
          }
        }
      }
    },
    "End the game and return to the home screen": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ grę i wróć do ekranu startowego"
          }
        }
      }
    },
    "Enter the console's IP address.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj adres IP konsoli."
          }
        }
      }
    },
    "Entire display %@×%@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cały ekran %@×%@"
          }
        }
      }
    },
    "Every display refresh gets a frame: either a real one or one computed between two real ones. A 24, 30 or 40 fps game then plays at a steady 60 fps on a 60 Hz display. Adds about 20–40 ms of latency.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde odświeżenie ekranu dostaje klatkę: prawdziwą albo wyliczoną między dwiema prawdziwymi. Gra 24, 30 czy 40 kl./s daje wtedy równe 60 kl./s na ekranie 60 Hz. Dodaje ok. 20–40 ms opóźnienia."
          }
        }
      }
    },
    "Exit full screen": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjście z pełnego ekranu"
          }
        }
      }
    },
    "FRAME GENERATION": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GENEROWANIE KLATEK"
          }
        }
      }
    },
    "Find consoles and refresh sources": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj konsol i odśwież źródła"
          }
        }
      }
    },
    "For weaker Wi‑Fi.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla słabszego Wi‑Fi."
          }
        }
      }
    },
    "Frame generation": {
      "localizations": {
        "pl": {
          "stringUnit": {
