        }
      }
    },
    "Click “Play” — the cursor and controls hide while you play": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „Graj” — kursor i przyciski chowają się w trakcie gry"
