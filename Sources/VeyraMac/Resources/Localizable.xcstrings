            "value": "Ekran gry"
          }
        }
      }
    },
    "Generates frames up to the full display refresh rate when the game clearly falls short of it (below about 85%).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorabia klatki do pełnego odświeżania ekranu, gdy gra wyraźnie go nie wypełnia (poniżej ok. 85%)."
          }
        }
      }
    },
