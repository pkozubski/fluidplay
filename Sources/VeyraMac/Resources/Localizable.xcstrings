      }
    },
    "Couldn't connect": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć"
          }
        }
      }
    },
    "Couldn't connect to the console. Check the IP address and network.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z konsolą. Sprawdź adres IP i sieć."
          }
        }
      }
    },
    "Couldn't create the texture cache.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć pamięci tekstur."
          }
        }
      }
    },
    "Couldn't start the session: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić sesji: %@"
          }
        }
