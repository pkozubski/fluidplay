    "Advanced": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaawansowane"
          }
        }
      }
    },
    "All windows (%lld)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie okna (%lld)"
          }
        }
      }
    },
    "All windows and test patterns on the home screen.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie okna i wzorce testowe na ekranie startowym."
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól…"
          }
        }
      }
    },
    "Always generates frames when the game doesn't fill the display refresh rate — even at 50–55 fps.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorabia klatki zawsze, gdy gra nie wypełnia odświeżania ekranu — także przy 50–55 kl./s."
          }
        }
      }
    },
    "Apple's model upscales video up to 720p by 1.5× before it reaches the display.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple powiększa obraz do 720p o 1,5×, zanim trafi na ekran."
          }
        }
      }
    },
    "Applies to capturing windows (e.g. PXPlay, Moonlight) and the whole display. Built-in Remote Play doesn't use these settings.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy przechwytywania okien (np. PXPlay, Moonlight) i całego ekranu. Wbudowany Remote Play z tego nie korzysta."
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
